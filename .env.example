# Copy to .env (gitignored). Every name the scripts and the edge function read.
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ORG_ID=
VAPI_WEBHOOK_SECRET=          # openssl rand -hex 32; also stored as the VAPI custom credential
SUPABASE_ACCESS_TOKEN=        # personal access token: CLI deploys + SQL over the Management API
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CLAIMS_TEAM_EMAIL=
OWNER_EMAIL=                  # seeded customers' email (Resend free tier delivers only to the account owner)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
JOBS_BEARER=                  # openssl rand -hex 32; same value as the Vault secret jobs_bearer
STAFF_EMAIL=
STAFF_PASSWORD=
REP_PHONE_E164=               # transfer target for the phone assistant
GHL_TOKEN=                    # GoHighLevel location Private Integration Token (contacts read/write); blank turns GHL off
GHL_LOCATION_ID=              # the one sub-account contacts, notes and tasks go to
GHL_ASSIGNEE_USER_ID=         # optional: GHL user the follow-up tasks are assigned to
GHL_EMERGENCY_USER_ID=        # optional: GHL user for the emergency task (default the assignee)
